// UsuarioResponse.java
public record UsuarioResponse(Long id, String nome, String email, Plano plano, StatusConta status) {
    public static UsuarioResponse de(Usuario u) {
        return new UsuarioResponse(u.getId(), u.getNome(), u.getEmail(), u.getPlano(), u.getStatus());
    }
}
